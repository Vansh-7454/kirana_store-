# Environment Variables Example for Kirana Store Website
# Copy this file to .env.local to customize environment settings

# Canonical Domain / Base URL (e.g., https://www.yourkiranastore.com)
NEXT_PUBLIC_SITE_URL=

# Optional Store Overrides (defaults are loaded from src/data/siteContent.ts)
NEXT_PUBLIC_STORE_NAME=
NEXT_PUBLIC_STORE_PHONE=
NEXT_PUBLIC_STORE_WHATSAPP=
